# smass configuration. Copy to .env and fill in. The LLM agents (full scan) need
# an API key; the scanners and --quick do not.

# Your LLM API key. smass is provider-agnostic: any Anthropic- or OpenAI-compatible
# API works. (ANTHROPIC_API_KEY is also accepted as the key variable.)
SMASS_LLM_API_KEY=

# Which compatible interface to speak: "anthropic" (default) or "openai".
SMASS_LLM_API=anthropic

# Optional: a custom endpoint base URL (a self-hosted gateway, an API relay, or a
# local proxy). Leave empty to use the provider's default endpoint. Set the
# SMASS_*_MODEL ids below to models the endpoint serves.
SMASS_LLM_BASE_URL=

# MCPwner container name (docker exec target).
SMASS_MCPWNER_CONTAINER=mcpwner-server
# Optional: write MCPwner's own log here instead of the terminal.
# SMASS_MCPWNER_LOG=~/.cache/smass/mcpwner.log

# Which specific scanner to run in each MCPwner category. Defaults shown.
SMASS_SECRETS_TOOL=trufflehog
SMASS_SAST_TOOL=semgrep
SMASS_SCA_TOOL=grype
# IaC scanner (checkov, kics, terrascan, tfsec, hadolint). Unset = IaC skipped.
SMASS_IAC_TOOL=

# Per-agent models (default: claude-opus-5-5). Downgrade workers if you like,
# e.g. SMASS_REVIEWER_MODEL=claude-sonnet-5-5
SMASS_MASTER_MODEL=claude-opus-5-5
SMASS_REVIEWER_MODEL=claude-opus-5-5
SMASS_POC_MODEL=claude-opus-5-5

# Paths (run output). Default to a .smass/ dir so a run does not clutter the cwd.
SMASS_MEMORY_PATH=.smass/reviewer_memory.json
SMASS_FINDINGS_DIR=.smass/findings

# `smass --airflow`: run the full scan as a smass_scan DAG run on a local Airflow
# (start it with scripts/airflow-standalone.sh, which also loads this file into
# the Airflow task processes). Password: leave empty to read the one
# `airflow standalone` generated under $AIRFLOW_HOME.
SMASS_AIRFLOW_URL=http://localhost:8080
SMASS_AIRFLOW_USER=admin
SMASS_AIRFLOW_PASSWORD=
SMASS_AIRFLOW_TIMEOUT=7200
